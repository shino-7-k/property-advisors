# === Notion（共通・必須） ===
# Notionインテグレーション（内部）トークン。https://www.notion.so/my-integrations で発行
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 記録先データベースID（作成済みDB: SNS投稿メトリクス / shingo.soccer713 ワークスペース）
NOTION_DATABASE_ID=611cc18feb1743f89eb739845cbc6a74

# === Instagram（自動取得用） ===
# Metaアプリで発行した長期アクセストークン
IG_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
# IGビジネスアカウントID（数値）
IG_USER_ID=1784xxxxxxxxxxx
# （任意）取得する最新投稿数
IG_MAX_POSTS=25
# （任意）Graph APIバージョン
IG_GRAPH_VERSION=v21.0
